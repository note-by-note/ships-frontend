                </span>

                <!-- 8-Language Selector Dropdown -->
                <div class="relative ml-2">
                    <select id="langSelector" onchange="changeLanguage(this.value)" class="bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-800 text-xs font-medium rounded-lg px-2.5 py-1.5 outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer transition-colors">
                        <option value="en">🇺🇸 English</option>
                        <option value="ko">🇰🇷 한국어</option>
