        // Scroll percentage calculator helper
        function updateScrollPercentage() {
            const scrollTop = viewer.scrollTop;
            const scrollHeight = viewer.scrollHeight - viewer.clientHeight;
            const scrollPercent = scrollHeight > 0 ? Math.min(100, Math.round((scrollTop / scrollHeight) * 100)) : 0;
            const viewedWord = translations[currentLang] ? translations[currentLang].viewed : 'viewed';
            scrollPercentLabel.textContent = scrollPercent + '% ' + viewedWord;
        }

        // Tab Switching
        function switchTab(tab) {
            const conductSec = document.getElementById('conductSection');
            const termsSec = document.getElementById('termsSection');
            const conductBtn = document.getElementById('tabConductBtn');
            const termsBtn = document.getElementById('tabTermsBtn');

            if (tab === 'conduct') {
                conductSec.classList.remove('hidden');
                termsSec.classList.add('hidden');
                conductBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 flex items-center gap-2 whitespace-nowrap transition-colors";
                termsBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 whitespace-nowrap transition-colors";
            } else {
                conductSec.classList.add('hidden');
                termsSec.classList.remove('hidden');
                termsBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 flex items-center gap-2 whitespace-nowrap transition-colors";
                conductBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 whitespace-nowrap transition-colors";
            }
        }

        // Track Document Scroll Percentage
        const viewer = document.getElementById('documentViewer');
        const scrollPercentLabel = document.getElementById('scrollPercent');

        viewer.addEventListener('scroll', updateScrollPercentage);

        // Form Acceptance Handler
        function handleAcceptance(e) {
            e.preventDefault();

            const nameInput = document.getElementById('fullName');
            const checkConduct = document.getElementById('checkConduct');
            const checkTerms = document.getElementById('checkTerms');
            const nameError = document.getElementById('nameError');

            if (!nameInput.value.trim()) {
                nameError.classList.remove('hidden');
                nameInput.focus();
                return;
            } else {
                nameError.classList.add('hidden');
            }

            if (!checkConduct.checked || !checkTerms.checked) {
                return;
            }

            // Create record
            const acceptanceRecord = {
                accepted: true,
                signerName: nameInput.value.trim(),
                timestamp: new Date().toLocaleString(),
                referenceId: 'CAD-' + Math.floor(100000 + Math.random() * 900000)
            };

            // Save state (Simulated LocalStorage)
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(acceptanceRecord));
            } catch (err) {
                console.log('Storage unavailable');
            }

            // Update UI State
            displayAcceptedState(acceptanceRecord);
        }

        // Update UI to Accepted State
        function displayAcceptedState(record) {
            const t = translations[currentLang] || translations.en;

            document.getElementById('statusAlert').classList.remove('hidden');
            document.getElementById('recordedName').textContent = record.signerName;
            document.getElementById('recordedDate').textContent = record.timestamp;
            document.getElementById('recordedRef').textContent = record.referenceId;

            // Form element updates
            document.getElementById('agreementFormCard').classList.add('opacity-75');
            document.getElementById('fullName').value = record.signerName;
            document.getElementById('fullName').disabled = true;
            document.getElementById('checkConduct').checked = true;
            document.getElementById('checkTerms').checked = true;
            document.getElementById('checkConduct').disabled = true;
            document.getElementById('checkTerms').disabled = true;
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.className = "w-full sm:w-auto px-6 py-3 bg-emerald-600 text-white font-semibold text-sm rounded-xl cursor-not-allowed flex items-center justify-center gap-2";
            submitBtn.innerHTML = `<i class="fa-solid fa-check"></i> <span>${t.btnAccepted}</span>`;

            // Header status update
            const badge = document.getElementById('headerStatusBadge');
            badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200";
            badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span> ${t.badgeVerified}`;
        }

        // Reset state for demo testing
        function resetAgreement() {
            const t = translations[currentLang] || translations.en;

            try {
                localStorage.removeItem(STORAGE_KEY);
            } catch (e) {}

            document.getElementById('statusAlert').classList.add('hidden');
            document.getElementById('agreementFormCard').classList.remove('opacity-75');
            document.getElementById('fullName').value = '';
            document.getElementById('fullName').disabled = false;
            document.getElementById('checkConduct').checked = false;
            document.getElementById('checkTerms').checked = false;
            document.getElementById('checkConduct').disabled = false;
            document.getElementById('checkTerms').disabled = false;

            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = false;
            submitBtn.className = "w-full sm:w-auto px-6 py-3 bg-brand-600 hover:bg-brand-700 active:bg-brand-900 text-white font-semibold text-sm rounded-xl shadow-md shadow-brand-500/20 hover:shadow-lg hover:shadow-brand-500/30 transition-all flex items-center justify-center gap-2";
            submitBtn.innerHTML = `<span>${t.btnSubmit}</span> <i class="fa-solid fa-arrow-right text-xs"></i>`;

            const badge = document.getElementById('headerStatusBadge');
            badge.className = "hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200";
            badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> ${t.badgeNeeded}`;
        }

        // On Load Check
        window.addEventListener('DOMContentLoaded', () => {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed && parsed.accepted) {
                        displayAcceptedState(parsed);
                    }
                }
            } catch (e) {}
        });
    </script>
</body>
</html>
