        function handleAcceptance(event) {
            event.preventDefault();
            const nameInput = document.getElementById('fullName');
            const nameError = document.getElementById('nameError');

            if (!nameInput.value.trim()) {
                nameError.classList.remove('hidden');
                return;
            }
            nameError.classList.add('hidden');

            const record = {
                name: nameInput.value.trim(),
                timestamp: new Date().toLocaleString(),
                refId: 'REF-' + Math.random().toString(36).substr(2, 9).toUpperCase()
            };

            localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
            applyStoredState(record);
        }

        function applyStoredState(record) {
            document.getElementById('agreementFormCard').classList.add('hidden');
            document.getElementById('statusAlert').classList.remove('hidden');
            document.getElementById('headerStatusBadge').className = "hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200";
            document.getElementById('headerStatusBadge').innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>${translations[currentLang].badgeVerified}</span>`;

            document.getElementById('recordedName').innerText = record.name;
            document.getElementById('recordedDate').innerText = record.timestamp;
            document.getElementById('recordedRef').innerText = record.refId;
        }

        function resetAgreement() {
            localStorage.removeItem(STORAGE_KEY);
            document.getElementById('statusAlert').classList.add('hidden');
            document.getElementById('agreementFormCard').classList.remove('hidden');
            document.getElementById('fullName').value = '';
            document.getElementById('checkConduct').checked = false;
            document.getElementById('checkTerms').checked = false;
            document.getElementById('headerStatusBadge').className = "hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200";
            document.getElementById('headerStatusBadge').innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span><span id="txt-badge">${translations[currentLang].badgeNeeded}</span>`;
        }

        function openTermsModal(e) {
            if (e) e.preventDefault();
            document.getElementById('termsModal').classList.remove('hidden');
        }

        function closeTermsModal() {
            document.getElementById('termsModal').classList.add('hidden');
        }

        function checkUrlHash() {
            const hash = window.location.hash.toLowerCase();
            if (hash === '#terms') {
                switchTab('terms');
            } else if (hash === '#conduct') {
                switchTab('conduct');
            }
        }

        const viewer = document.getElementById('documentViewer');
        viewer.addEventListener('scroll', () => {
            const scrollTop = viewer.scrollTop;
            const scrollHeight = viewer.scrollHeight - viewer.clientHeight;
            const scrollPercent = scrollHeight > 0 ? Math.round((scrollTop / scrollHeight) * 100) : 100;
            document.getElementById('scrollPercent').innerText = `${scrollPercent}% ${translations[currentLang].viewed || 'viewed'}`;
        });

        window.addEventListener('DOMContentLoaded', () => {
            checkUrlHash();
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    applyStoredState(JSON.parse(saved));
                } catch (e) {
                    localStorage.removeItem(STORAGE_KEY);
                }
            }
        });

        window.addEventListener('hashchange', checkUrlHash);
    </script>
