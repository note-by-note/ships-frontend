        function switchTab(tab) {
            const conductSec = document.getElementById('conductSection');
            const termsSec = document.getElementById('termsSection');
            const conductBtn = document.getElementById('tabConductBtn');
            const termsBtn = document.getElementById('tabTermsBtn');

            if (tab === 'conduct') {
                conductSec.classList.remove('hidden');
                termsSec.classList.add('hidden');
                conductBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 flex items-center gap-2 whitespace-nowrap transition-colors";
                termsBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 whitespace-nowrap transition-colors";
            } else {
                conductSec.classList.add('hidden');
                termsSec.classList.remove('hidden');
                termsBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 flex items-center gap-2 whitespace-nowrap transition-colors";
                conductBtn.className = "px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 whitespace-nowrap transition-colors";
            }
        }

