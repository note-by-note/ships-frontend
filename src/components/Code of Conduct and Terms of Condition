                <button onclick="closeTermsModal()" class="w-8 h-8 rounded-lg bg-slate-200/60 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto space-y-4 text-slate-700 text-sm leading-relaxed">
                <h4 class="font-bold text-slate-900 text-base">Quick Access Summary</h4>
                <p>You can view and read the full Code of Conduct and Terms of Service directly in the main viewer card on this page.</p>
                <div class="flex gap-2 pt-2">
                    <button onclick="closeTermsModal(); switchTab('conduct');" class="px-4 py-2 bg-brand-50 text-brand-600 font-medium text-xs rounded-xl hover:bg-brand-100 transition-colors">
