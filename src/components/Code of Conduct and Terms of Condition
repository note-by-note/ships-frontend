                    </button>
                </div>
            </div>
            <div class="px-6 py-3 border-t border-slate-200 bg-slate-50 text-right">
                <button onclick="closeTermsModal()" class="px-4 py-2 bg-slate-800 text-white font-medium text-xs rounded-xl hover:bg-slate-900 transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>

