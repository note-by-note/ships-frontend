            <p id="txt-subtitle" class="mt-2 text-slate-600 text-sm sm:text-base">Please review our Code of Conduct and Terms of Service carefully before joining our mentorship network.</p>
        </div>

        <!-- Agreement Status Card -->
        <div id="statusAlert" class="hidden mb-8 p-6 bg-emerald-50 border border-emerald-200 rounded-2xl shadow-sm transition-all duration-300">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-600 shrink-0">
                    <i class="fa-solid fa-circle-check text-2xl"></i>
                </div>
                <div class="flex-1">
                    <h3 id="txt-alert-title" class="text-lg font-bold text-emerald-900">Code of Conduct Accepted</h3>
                    <p id="txt-alert-subtitle" class="text-sm text-emerald-700 mt-1">Thank you for committing to a safe and inspiring musical community.</p>

                    <div class="mt-4 pt-4 border-t border-emerald-200/60 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-emerald-800">
                        <div>
                            <span id="txt-lbl-signedby" class="text-emerald-600 font-medium block">Signed By:</span>
                            <span id="recordedName" class="font-bold text-emerald-950">-</span>
                        </div>
                        <div>
                            <span id="txt-lbl-timestamp" class="text-emerald-600 font-medium block">Timestamp:</span>
                            <span id="recordedDate" class="font-bold text-emerald-950">-</span>
                        </div>
                        <div>
                            <span id="txt-lbl-ref" class="text-emerald-600 font-medium block">Reference ID:</span>
                            <span id="recordedRef" class="font-bold font-mono text-emerald-950">-</span>
                        </div>
                    </div>

                    <div class="mt-5 flex flex-wrap gap-3">
                        <button onclick="resetAgreement()" class="px-3.5 py-1.5 text-xs font-semibold text-emerald-800 bg-emerald-100 hover:bg-emerald-200 rounded-lg transition-colors border border-emerald-300">
                            <i class="fa-solid fa-rotate-left mr-1"></i> <span id="txt-btn-reset">Reset Acceptance State</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Document Box -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-8">

            <!-- Document Navigation Tabs -->
            <div class="flex border-b border-slate-200 bg-slate-50/80 px-4 pt-3 gap-2 overflow-x-auto">
                <button id="tabConductBtn" onclick="switchTab('conduct')" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-brand-600 text-brand-600 flex items-center gap-2 whitespace-nowrap transition-colors">
                    <i class="fa-solid fa-shield-halved"></i> <span id="txt-tab-conduct">1. Code of Conduct</span>
                </button>
                <button id="tabTermsBtn" onclick="switchTab('terms')" class="px-4 py-2.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 whitespace-nowrap transition-colors">
                    <i class="fa-solid fa-file-contract"></i> <span id="txt-tab-terms">2. Terms of Service</span>
                </button>
            </div>

            <!-- Scrollable Content Viewport -->
