                </div>
            </div>

            <div class="flex items-center gap-3">
                <!-- Direct Access Button for Modal -->
                <button onclick="openTermsModal(event)" class="text-xs font-semibold text-slate-600 hover:text-brand-600 border border-slate-200 bg-slate-50 hover:bg-white px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-scale-balanced text-brand-600"></i>
                    <span id="txt-nav-quickterms">Quick Terms View</span>
                </button>

                <span id="headerStatusBadge" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
